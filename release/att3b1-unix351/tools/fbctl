#!/usr/bin/env python3
"""fbctl - send commands to FreeBee's control socket.

  fbctl [-s SOCKET] 'command' ['command' ...]
  echo 'command' | fbctl [-s SOCKET] -

The socket defaults to $FREEBEE_CONTROL, else freebee.sock in this VM folder.
Commands: type TEXT, key NAME.., floppy PATH, eject, hd2 PATH,
screenshot PATH, mouse DX DY [B], speed max|real, turbo N (1 to 32),
status, quit. Prints each answer.
Exit status 1 if any answer starts with "err".
"""
import os
import socket
import sys

here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
args = sys.argv[1:]
path = os.environ.get("FREEBEE_CONTROL") or os.path.join(here, "freebee.sock")
if len(args) >= 2 and args[0] == "-s":
    path = args[1]
    args = args[2:]
if args == ["-"]:
    args = [l.rstrip("\n") for l in sys.stdin if l.strip()]
if not args:
    print(__doc__.strip())
    sys.exit(2)

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    # a Unix socket's path holds only about 100 bytes: for a longer one,
    # go to its folder and connect by name
    folder, name = os.path.split(path)
    if folder and len(os.fsencode(path)) > 90:
        os.chdir(folder)
        s.connect(name)
    else:
        s.connect(path)
except OSError as e:
    print("fbctl: cannot connect to %s: %s" % (path, e), file=sys.stderr)
    sys.exit(2)
f = s.makefile("rw", encoding="latin-1", newline="\n")
bad = False
for cmd in args:
    f.write(cmd + "\n")
    f.flush()
    ans = f.readline().rstrip("\n")
    print(ans)
    if not ans or ans.startswith("err"):
        bad = True
s.close()
sys.exit(1 if bad else 0)
